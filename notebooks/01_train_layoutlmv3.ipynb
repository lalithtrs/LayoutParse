  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# DocuExtract — Fine-Tuning LayoutLMv3 on SROIE\n",
    "### End-to-end receipt key information extraction (Company, Date, Address, Total)\n",
    "\n",   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Install Dependencies & Check GPU"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!nvidia-smi\n",
    "!pip install -q transformers[torch] datasets seqeval evaluate torchvision pillow"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Dataset from Hugging Face"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from datasets import load_dataset\n",
    "\n",
    "# ICDAR 2019 SROIE mirror\n",
    "dataset = load_dataset('jsdnrs/ICDAR2019-SROIE')\n",
    "print(dataset)\n",
    "print('Sample keys:', dataset['train'][0].keys())\n",
    "print('Sample entities:', dataset['train'][0]['entities'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Define Labels & BIO Schema"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "label_list = [\n",
    "    'O',\n",
    "    'B-COMPANY', 'I-COMPANY',\n",
    "    'B-DATE', 'I-DATE',\n",
    "    'B-ADDRESS', 'I-ADDRESS',\n",
    "    'B-TOTAL', 'I-TOTAL'\n",
    "]\n",
    "label2id = {label: i for i, label in enumerate(label_list)}\n",
    "id2label = {i: label for i, label in enumerate(label_list)}\n",
    "print('Labels:', label2id)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Robust Preprocessing & Text-Based BIO Alignment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "from transformers import AutoProcessor\n",
    "\n",
    "model_id = 'microsoft/layoutlmv3-base'\n",
    "processor = AutoProcessor.from_pretrained(model_id, apply_ocr=False)\n",
    "\n",
    "def clean_text(text):\n",
    "    return re.sub(r'[^\\w\\s]', '', str(text)).lower().strip()\n",
    "\n",
    "def find_subsequence(sequence, target):\n",
    "    matches = []\n",
    "    if not target or not sequence or len(target) > len(sequence):\n",
    "        return matches\n",
    "    t_len = len(target)\n",
    "    for i in range(len(sequence) - t_len + 1):\n",
    "        if sequence[i : i + t_len] == target:\n",
    "            matches.append((i, i + t_len))\n",
    "    return matches\n",
    "\n",
    "def assign_bio_tags(doc_words, doc_entities):\n",
    "    tags = ['O'] * len(doc_words)\n",
    "    cleaned_tokens = [clean_text(w) for w in doc_words]\n",
    "    occupied = [False] * len(doc_words)\n",
    "\n",
    "    entity_items = [\n",
    "        (k.upper(), str(v))\n",
    "        for k, v in doc_entities.items()\n",
    "        if v and k.lower() in ['company', 'date', 'address', 'total']\n",
    "    ]\n",
    "    entity_items.sort(key=lambda x: len(x[1]), reverse=True)\n",
    "\n",
    "    for entity_name, entity_val in entity_items:\n",
    "        val_tokens = [clean_text(w) for w in entity_val.split() if clean_text(w)]\n",
    "        if not val_tokens:\n",
    "            continue\n",
    "\n",
    "        b_tag = f'B-{entity_name}'\n",
    "        i_tag = f'I-{entity_name}'\n",
    "\n",
    "        matches = find_subsequence(cleaned_tokens, val_tokens)\n",
    "\n",
    "        if not matches and len(val_tokens) == 1:\n",
    "            target_word = val_tokens[0]\n",
    "            for idx, c_tok in enumerate(cleaned_tokens):\n",
    "                if not occupied[idx] and (target_word == c_tok or (len(target_word) > 2 and target_word in c_tok)):\n",
    "                    matches.append((idx, idx + 1))\n",
    "                    break\n",
    "\n",
    "        for start_idx, end_idx in matches:\n",
    "            if any(occupied[idx] for idx in range(start_idx, end_idx)):\n",
    "                continue\n",
    "            tags[start_idx] = b_tag\n",
    "            occupied[start_idx] = True\n",
    "            for idx in range(start_idx + 1, end_idx):\n",
    "                tags[idx] = i_tag\n",
    "                occupied[idx] = True\n",
    "            break\n",
    "\n",
    "    return tags\n",
    "\n",
    "def prepare_examples(examples):\n",
    "    images = [img.convert('RGB') for img in examples['image']]\n",
    "    words = examples['words']\n",
    "    boxes = examples['bboxes']\n",
    "    entities_list = examples['entities']\n",
    "\n",
    "    clamped_boxes = []\n",
    "    for doc_boxes in boxes:\n",
    "        normalized_doc_boxes = []\n",
    "        for box in doc_boxes:\n",
    "            x1 = max(0, min(1000, int(box[0])))\n",
    "            y1 = max(0, min(1000, int(box[1])))\n",
    "            x2 = max(x1, min(1000, int(box[2])))\n",
    "            y2 = max(y1, min(1000, int(box[3])))\n",
    "            normalized_doc_boxes.append([x1, y1, x2, y2])\n",
    "        clamped_boxes.append(normalized_doc_boxes)\n",
    "\n",
    "    batch_word_labels = []\n",
    "    for batch_idx in range(len(words)):\n",
    "        doc_words = words[batch_idx]\n",
    "        doc_entities = entities_list[batch_idx]\n",
    "        word_labels = assign_bio_tags(doc_words, doc_entities)\n",
    "        word_label_ids = [label2id.get(lbl, 0) for lbl in word_labels]\n",
    "        batch_word_labels.append(word_label_ids)\n",
    "\n",
    "    encoding = processor(\n",
    "        images,\n",
    "        words,\n",
    "        boxes=clamped_boxes,\n",
    "        word_labels=batch_word_labels,\n",
    "        truncation=True,\n",
    "        padding='max_length',\n",
    "        max_length=512,\n",
    "        return_tensors='pt'\n",
    "    )\n",
    "    return encoding"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Load Model & Training Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import evaluate\n",
    "import numpy as np\n",
    "from transformers import (\n",
    "    LayoutLMv3ForTokenClassification,\n",
    "    TrainingArguments,\n",
    "    Trainer,\n",
    "    default_data_collator,\n",
    ")\n",
    "\n",
    "model = LayoutLMv3ForTokenClassification.from_pretrained(\n",
    "    model_id,\n",
    "    num_labels=len(label_list),\n",
    "    id2label=id2label,\n",
    "    label2id=label2id\n",
    ")\n",
    "\n",
    "seqeval = evaluate.load('seqeval')\n",
    "\n",
    "def compute_metrics(p):\n",
    "    predictions, labels = p\n",
    "    predictions = np.argmax(predictions, axis=2)\n",
    "    true_predictions = [\n",
    "        [label_list[p_idx] for (p_idx, l_idx) in zip(prediction, label) if l_idx != -100]\n",
    "        for prediction, label in zip(predictions, labels)\n",
    "    ]\n",
    "    true_labels = [\n",
    "        [label_list[l_idx] for (p_idx, l_idx) in zip(prediction, label) if l_idx != -100]\n",
    "        for prediction, label in zip(predictions, labels)\n",
    "    ]\n",
    "    results = seqeval.compute(predictions=true_predictions, references=true_labels)\n",
    "    return {\n",
    "        'precision': results['overall_precision'],\n",
    "        'recall': results['overall_recall'],\n",
    "        'overall_f1': results['overall_f1'],\n",
    "        'accuracy': results['overall_accuracy'],\n",
    "    }\n",
    "\n",
    "# Handle eval_strategy (transformers >= 4.41) vs legacy evaluation_strategy (< 4.41)\n",
    "eval_strategy_kwargs = (\n",
    "    {'eval_strategy': 'steps'}\n",
    "    if 'eval_strategy' in TrainingArguments.__init__.__code__.co_varnames\n",
    "    else {'evaluation_strategy': 'steps'}\n",
    ")\n",
    "\n",
    "training_args = TrainingArguments(\n",
    "    output_dir='checkpoints_layoutlmv3',\n",
    "    max_steps=1000,\n",
    "    per_device_train_batch_size=4,\n",
    "    per_device_eval_batch_size=4,\n",
    "    learning_rate=2e-5,\n",
    "    save_strategy='steps',\n",
    "    eval_steps=200,\n",
    "    save_steps=200,\n",
    "    save_total_limit=2,\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model='overall_f1',\n",
    "    fp16=torch.cuda.is_available(),\n",
    "    logging_steps=50,\n",
    "    **eval_strategy_kwargs\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Train the Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Preprocess splits\n",
    "encoded_dataset = dataset.map(\n",
    "    prepare_examples,\n",
    "    batched=True,\n",
    "    batch_size=2,\n",
    "    remove_columns=dataset['train'].column_names\n",
    ")\n",
    "encoded_dataset.set_format('torch')\n",
    "\n",
    "# Support modern (processing_class) and legacy (tokenizer) Trainer arguments\n",
    "trainer_kwargs = {\n",
    "    'model': model,\n",
    "    'args': training_args,\n",
    "    'train_dataset': encoded_dataset['train'],\n",
    "    'eval_dataset': encoded_dataset['test'],\n",
    "    'data_collator': default_data_collator,\n",
    "    'compute_metrics': compute_metrics,\n",
    "}\n",
    "if 'processing_class' in Trainer.__init__.__code__.co_varnames:\n",
    "    trainer_kwargs['processing_class'] = processor\n",
    "else:\n",
    "    trainer_kwargs['tokenizer'] = processor\n",
    "\n",
    "trainer = Trainer(**trainer_kwargs)\n",
    "\n",
    "trainer.train()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Evaluate & Inspect Classification Report"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "eval_metrics = trainer.evaluate()\n",
    "print('Final Evaluation Metrics:', eval_metrics)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Export Model Artifacts & Download"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "save_dir = 'best_layoutlmv3_sroie'\n",
    "zip_filename = 'best_layoutlmv3_sroie.zip'\n",
    "\n",
    "# 1. Save trained model weights and processor artifacts\n",
    "print(f\"Saving fine-tuned model and processor to '{save_dir}'...\")\n",
    "trainer.save_model(save_dir)\n",
    "processor.save_pretrained(save_dir)\n",
    "\n",
    "# 2. Package into zip archive\n",
    "print(f\"Creating archive '{zip_filename}'...\")\n",
    "if os.system(f\"zip -r -q {zip_filename} {save_dir}\") != 0:\n",
    "    shutil.make_archive(save_dir, 'zip', save_dir)\n",
    "\n",
    "file_size_mb = os.path.getsize(zip_filename) / (1024 * 1024)\n",
    "print(f\"✓ Archive created: {zip_filename} ({file_size_mb:.2f} MB)\")\n",
    "\n",
    "# 3. Environment-aware download handling (Kaggle vs Colab vs Local)\n",
    "is_kaggle = 'KAGGLE_KERNEL_RUN_TYPE' in os.environ or os.path.exists('/kaggle/working')\n",
    "\n",
    "is_colab = False\n",
    "try:\n",
    "    import google.colab\n",
    "    is_colab = True\n",
    "except ImportError:\n",
    "    pass\n",
    "\n",
    "if is_kaggle:\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"🎉 Kaggle Model Export Complete!\")\n",
    "    print(\"=\" * 60)\n",
    "    print(\"How to download your model in Kaggle:\")\n",
    "    print(\"1. Check the right sidebar panel under 'Output' -> '/kaggle/working'.\")\n",
    "    print(f\"2. Hover over '{zip_filename}', click the three dots (...), and choose 'Download'.\")\n",
    "    print(\"3. Or click the direct download link below:\")\n",
    "    try:\n",
    "        from IPython.display import display, FileLink\n",
    "        display(FileLink(zip_filename))\n",
    "    except Exception:\n",
    "        pass\n",
    "    print(\"=\" * 60)\n",
    "elif is_colab:\n",
    "    try:\n",
    "        from google.colab import files\n",
    "        print(\"Initiating Google Colab browser download...\")\n",
    "        files.download(zip_filename)\n",
    "    except Exception as e:\n",
    "        print(f\"Browser download skipped ({e}). Download '{zip_filename}' manually from the Colab file browser on the left.\")\n",
    "else:\n",
    "    print(f\"Model archive saved at: {os.path.abspath(zip_filename)}\")\n",
    "    try:\n",
    "        from IPython.display import display, FileLink\n",
    "        display(FileLink(zip_filename))\n",
    "    except Exception:\n",
    "        pass"
   ]
